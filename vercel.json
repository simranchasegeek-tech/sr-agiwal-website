{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/handler.js": {
      "includeFiles": [
        "index.html",
        "about.html",
        "service.html",
        "important-links.html",
        "tools.html",
        "contact.html",
        "404.html",
        "styles.css",
        "script.js"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/service",
      "destination": "/service.html"
    },
    {
      "source": "/services",
      "destination": "/service.html"
    },
    {
      "source": "/important-links",
      "destination": "/important-links.html"
    },
    {
      "source": "/tools",
      "destination": "/tools.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    }
  ]
}
